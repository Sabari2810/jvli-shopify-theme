{%- comment -%}
  Price for a variant, with the compare-at price struck through when on sale.
  Params: variant; extra (optional, in paise) is added to both, e.g. the
  dupatta's price when "With dupatta" is chosen.
{%- endcomment -%}
{%- liquid
  assign jvli_extra = extra | default: 0
  assign jvli_now = variant.price | plus: jvli_extra
  assign jvli_was = variant.compare_at_price | plus: jvli_extra
-%}
<span class="jvli-product__price-now">{{ jvli_now | money_without_trailing_zeros }}</span>
{%- if variant.compare_at_price > variant.price -%}
  <s class="jvli-product__price-was">{{ jvli_was | money_without_trailing_zeros }}</s>
{%- endif -%}
