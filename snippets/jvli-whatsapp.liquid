{%- comment -%}
  Floating WhatsApp chat button, rendered on every page by layout/theme.liquid.
  Settings: Theme settings > WhatsApp chat. On a product page the message
  names the product and includes its link.
{%- endcomment -%}
{%- liquid
  assign wa_number = settings.jvli_whatsapp_number | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  assign wa_show = true
  if settings.jvli_whatsapp_enabled == false or wa_number == blank
    assign wa_show = false
  endif

  if template.name == 'product' and product
    assign wa_text = settings.jvli_whatsapp_product_message | replace: '[product]', product.title
    assign wa_text = wa_text | append: ' ' | append: shop.url | append: product.url
  else
    assign wa_text = settings.jvli_whatsapp_message
  endif
  # url_encode turns spaces into "+"; WhatsApp expects %20 (a real "+" is already %2B).
  assign wa_text = wa_text | url_encode | replace: '+', '%20'
-%}
{%- if wa_show -%}
<a
  class="jvli-wa"
  href="https://wa.me/{{ wa_number }}{% if wa_text != blank %}?text={{ wa_text }}{% endif %}"
  target="_blank"
  rel="noopener"
  aria-label="Chat with us on WhatsApp"
>
  <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <path d="M16.04 3C8.86 3 3.03 8.82 3.03 15.99c0 2.29.6 4.53 1.74 6.5L3 29l6.68-1.75a12.97 12.97 0 0 0 6.36 1.63h.01c7.17 0 13-5.83 13-13S23.21 3 16.04 3Zm0 23.68h-.01a10.8 10.8 0 0 1-5.5-1.51l-.4-.23-3.96 1.04 1.06-3.86-.26-.4a10.74 10.74 0 0 1-1.65-5.73c0-5.96 4.85-10.8 10.82-10.8 2.89 0 5.6 1.13 7.64 3.17a10.73 10.73 0 0 1 3.16 7.64c0 5.96-4.85 10.8-10.81 10.8Zm5.93-8.09c-.33-.16-1.93-.95-2.23-1.06-.3-.11-.52-.16-.73.16-.22.33-.84 1.06-1.03 1.28-.19.22-.38.24-.7.08-.33-.16-1.38-.51-2.62-1.62-.97-.86-1.62-1.93-1.81-2.25-.19-.33-.02-.5.14-.66.15-.15.33-.38.49-.57.16-.19.22-.33.33-.54.11-.22.05-.41-.03-.57-.08-.16-.73-1.76-1-2.41-.26-.63-.53-.55-.73-.56h-.62c-.22 0-.57.08-.87.41-.3.33-1.14 1.11-1.14 2.71s1.17 3.15 1.33 3.36c.16.22 2.3 3.51 5.57 4.92.78.34 1.39.54 1.86.69.78.25 1.49.21 2.05.13.63-.09 1.93-.79 2.2-1.55.27-.76.27-1.41.19-1.55-.08-.13-.3-.21-.62-.37Z"/>
  </svg>
</a>
<style>
  .jvli-wa {
    position: fixed;
    right: max(20px, env(safe-area-inset-right));
    bottom: max(20px, env(safe-area-inset-bottom));
    /* Above the page, below the header and its full-screen menu (40). */
    z-index: 35;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: {{ settings.jvli_whatsapp_color | default: '#652c28' }};
    color: #fff;
    box-shadow: 0 6px 18px rgba(34, 28, 24, 0.22), 0 2px 4px rgba(34, 28, 24, 0.14);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .jvli-wa svg {
    width: 30px;
    height: 30px;
    fill: currentColor;
  }
  .jvli-wa:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(34, 28, 24, 0.26), 0 3px 6px rgba(34, 28, 24, 0.16);
  }
  .jvli-wa:focus-visible {
    outline: 2px solid #221c18;
    outline-offset: 3px;
  }
  @media (max-width: 749px) {
    .jvli-wa {
      right: max(16px, env(safe-area-inset-right));
      bottom: max(16px, env(safe-area-inset-bottom));
      width: 52px;
      height: 52px;
    }
    .jvli-wa svg {
      width: 28px;
      height: 28px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .jvli-wa { transition: none; }
  }
  @media print {
    .jvli-wa { display: none; }
  }
</style>
{%- endif -%}
