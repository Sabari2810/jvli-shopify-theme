  <style>
    .jvli-intro {
      position: fixed;
      inset: 0;
      z-index: 2147483000;
      display: grid;
      place-items: center;
      background: #f5f1ea;
      cursor: pointer;
      transition: opacity 0.45s ease, visibility 0.45s ease;
    }
    .jvli-intro[hidden] { display: none; }
    .jvli-intro.is-leaving { opacity: 0; visibility: hidden; }
    .jvli-intro__inner {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 22px;
    }
    .jvli-intro__kolam {
      width: clamp(120px, 34vw, 168px);
      height: auto;
      overflow: visible;
    }
    .jvli-intro__line {
      fill: none;
      stroke: #763530;
      stroke-width: 2.2;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: jvli-intro-draw 1.9s cubic-bezier(0.45, 0, 0.3, 1) 0.45s forwards;
    }
    .jvli-intro__dots circle {
      fill: #b08c60;
      opacity: 0;
      transform-box: fill-box;
      transform-origin: center;
      animation: jvli-intro-dot 0.35s ease calc(var(--i) * 0.018s) forwards;
    }
    .jvli-intro__mark {
      margin: 0;
      color: #b0894f;
      font-family: "Newsreader", "Iowan Old Style", Georgia, serif;
      font-size: 26px;
      letter-spacing: 0.32em;
      text-indent: 0.32em;
      opacity: 0;
      animation: jvli-intro-fade 0.5s ease 2.2s forwards;
    }
    @keyframes jvli-intro-draw { to { stroke-dashoffset: 0; } }
    @keyframes jvli-intro-dot {
      from { opacity: 0; transform: scale(0.2); }
      to { opacity: 1; transform: scale(1); }
    }
    @keyframes jvli-intro-fade {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: none; }
    }
  </style>
  <script>
    (function () {
      var intro = document.getElementById('JvliIntro');
      if (!intro) return;
      try {
        if (window.sessionStorage.getItem('jvli:intro')) return intro.remove();
        window.sessionStorage.setItem('jvli:intro', '1');
      } catch (error) {
        return intro.remove();
      }
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return intro.remove();

      intro.hidden = false;
      var HOLD_MS = 300; // after "JVLI" has faded in (2.7s into the drawing)
      var SAFETY_MS = 8000; // in case the animation never runs
      var done = false;
      function hide() {
        if (done) return;
        done = true;
        intro.classList.add('is-leaving');
        setTimeout(function () {
          intro.remove();
        }, 500);
      }
      var mark = intro.querySelector('.jvli-intro__mark');
      if (mark) {
        mark.addEventListener('animationend', function () {
          setTimeout(hide, HOLD_MS);
        });
      }
      setTimeout(hide, SAFETY_MS);
      intro.addEventListener('click', hide);
      document.addEventListener('keydown', hide, { once: true });
    })();
  </script>
{%- endif -%}
