    {%- when 'sprout' -%}
      <path d="M12 21v-9M12 12C12 7 9 4.5 4 4.5c0 5 3 7.5 8 7.5ZM12 13c0-4 2.5-6 6.5-6 0 4-2.5 6-6.5 6Z" />
    {%- else -%}
      <path d="M5 19C5 10 10 5 19 5c0 9-5 14-14 14Z" /><path d="M5 19 14 10" />
  {%- endcase -%}
</svg>
