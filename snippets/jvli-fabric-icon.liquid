{%- comment -%}
  Line icons for fabric features (sections/jvli-our-fabrics).
  Params: icon (leaf, waves, sun, feather, cloud, heat, heart, hand, shirt,
  wind, sparkle, sprout).
{%- endcomment -%}
<svg class="jvli-fabric-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {%- case icon -%}
    {%- when 'waves' -%}
      <path d="M3 8c3-3 5-3 8 0s5 3 8 0l2-1M3 13c3-3 5-3 8 0s5 3 8 0l2-1M3 18c3-3 5-3 8 0s5 3 8 0l2-1" />
