      <path d="M20 4C12 4 6 9 5 19l-1 2M5 19c7 0 12-5 13-11M8.5 15.5 15 9" /><path d="M20 4c0 2-.5 3-2 4" />
    {%- when 'cloud' -%}
      <path d="M7 18h10a4 4 0 0 0 .6-8A6 6 0 0 0 6.2 9.6 4.2 4.2 0 0 0 7 18Z" />
    {%- when 'heat' -%}
      <path d="M7 4c-2 3 2 5 0 8s2 5 0 8M12 4c-2 3 2 5 0 8s2 5 0 8M17 4c-2 3 2 5 0 8s2 5 0 8" />
    {%- when 'heart' -%}
