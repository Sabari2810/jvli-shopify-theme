    {%- when 'shirt' -%}
      <path d="M9 3.5 4 6 2.5 10.5 6 12v8.5h12V12l3.5-1.5L20 6l-5-2.5c-.5 1.6-1.6 2.5-3 2.5s-2.5-.9-3-2.5Z" />
