{%- render 'jvli-assets' -%}
<section class="jvli jvli-gallery jvli-section">
  <div class="jvli-container">
    <div class="jvli-gallery__head">
      <h2 class="jvli-h2">{{ section.settings.heading }}</h2>
      <span class="jvli-gallery__rule" aria-hidden="true"></span>
      {%- if section.settings.follow_text != blank -%}
        {%- if section.settings.follow_link != blank -%}
          <a href="{{ section.settings.follow_link }}" class="jvli-link-caps" target="_blank" rel="noopener">{{ section.settings.follow_text }}</a>
        {%- else -%}
          <span class="jvli-link-caps">{{ section.settings.follow_text }}</span>
        {%- endif -%}
      {%- endif -%}
    </div>
    {%- comment -%}
      The photo blocks render first and stay as the fallback. When an
      Instagram feed URL is set, jvli-home.js swaps in the latest reels whose
      thumbnails load. Photo slots without an image (data-jvli-empty) are
      only loading tiles: they are never kept, and if nothing real is left
      the whole section hides.
    {%- endcomment -%}
    <div
      class="jvli-gallery__row"
      {% if section.settings.clothesline %}data-jvli-clothesline{% endif %}
      {% if section.settings.instagram_feed_url != blank %}
        data-jvli-reels="{{ section.settings.instagram_feed_url | escape }}"
        data-jvli-reels-count="{{ section.settings.reels_count }}"
        data-jvli-reels-display="{{ section.settings.reels_display }}"
        data-jvli-reels-handle="{{ section.settings.instagram_handle | escape }}"
        {% if section.settings.instagram_avatar != blank %}
          data-jvli-reels-avatar="{{ section.settings.instagram_avatar | image_url: width: 96, height: 96, crop: 'top' }}"
        {% endif %}
      {% endif %}
    >
      {%- for block in section.blocks limit: section.settings.reels_count -%}
        {%- capture jvli_gallery_image -%}
          {%- render 'jvli-media',
            image: block.settings.image,
            alt: block.settings.alt,
            sizes: '(max-width: 749px) 60vw, 20vw',
            class: 'jvli-cover',
            placeholder: 'lifestyle-1'
          -%}
        {%- endcapture -%}
        {%- liquid
          assign jvli_empty = ''
          if block.settings.image == blank
            assign jvli_empty = ' data-jvli-empty'
          endif
        -%}
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" class="jvli-gallery__item"{{ jvli_empty }} {{ block.shopify_attributes }}>{{ jvli_gallery_image }}</a>
        {%- else -%}
          <div class="jvli-gallery__item"{{ jvli_empty }} {{ block.shopify_attributes }}>{{ jvli_gallery_image }}</div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "JVLI Gallery",
  "class": "jvli-section-gallery",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "JVLI in real life" },
    { "type": "text", "id": "follow_text", "label": "Follow text", "default": "Follow us @jvli.store" },
    { "type": "checkbox", "id": "clothesline", "label": "Hang them on a clothesline", "default": true, "info": "Pegged to a line of twine; they sway as the page scrolls." },
    { "type": "url", "id": "follow_link", "label": "Follow link", "info": "e.g. your Instagram profile" },
    { "type": "header", "content": "Instagram reels" },
    {
      "type": "text",
      "id": "instagram_feed_url",
      "label": "Reels feed URL",
      "default": "https://jvli-shopify-instagram.thejvlistore.workers.dev/reels",
      "info": "Shows your latest Instagram reels. Leave empty to show only the photos below; they are also shown if the feed can't be reached."
    },
    { "type": "range", "id": "reels_count", "label": "Number of items", "min": 3, "max": 8, "step": 1, "default": 4 },
    {
      "type": "select",
      "id": "reels_display",
      "label": "Show reels as",
      "default": "post",
      "options": [
        { "value": "post", "label": "Instagram posts" },
        { "value": "tiles", "label": "Tiles" }
      ],
      "info": "Both open the reel on Instagram. Posts add the profile, icons and caption around each reel."
    },
    { "type": "text", "id": "instagram_handle", "label": "Instagram username", "default": "jvli.store" },
    { "type": "image_picker", "id": "instagram_avatar", "label": "Profile picture", "info": "Shown round, like on Instagram. Square, at least 96 × 96." }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "1080 × 1080" },
        { "type": "text", "id": "alt", "label": "Image description" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{
    "name": "JVLI Gallery",
    "blocks": [{ "type": "photo" }, { "type": "photo" }, { "type": "photo" }, { "type": "photo" }]
  }]
}
{% endschema %}
