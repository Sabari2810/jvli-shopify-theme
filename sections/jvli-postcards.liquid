{%- comment -%}
  Postcards from you: customer reviews as postcards in a carousel.
  Each review is a block typed in the theme editor. Only add real reviews,
  and tick "Verified customer" only for people who bought from JVLI.
  The section renders nothing until it has at least one review.
  jvli-postcards.js runs the arrows, dots and swipe, and the "Read more"
  pop-up for long reviews.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  {%- render 'jvli-assets' -%}
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@1,400&family=Marck+Script&display=swap">
  {{ 'jvli-postcards.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'jvli-postcards.js' | asset_url }}" defer></script>

  <section
    class="jvli jvli-postcards jvli-section"
    data-jvli-postcards
    aria-roledescription="carousel"
    aria-labelledby="JvliPostcards-{{ section.id }}"
  >
    {%- if section.settings.show_flowers -%}
      <img
        class="jvli-postcards__corner"
        src="{{ 'jvli-sprig-corner.webp' | asset_url }}"
        alt=""
        width="290"
        height="192"
        loading="lazy"
      >
    {%- endif -%}

    <div class="jvli-container">
      <div class="jvli-postcards__head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="jvli-eyebrow jvli-postcards__eyebrow"><span>{{ section.settings.eyebrow }}</span></p>
        {%- endif -%}
        <h2 class="jvli-h2" id="JvliPostcards-{{ section.id }}">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="jvli-postcards__text">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>

      <div class="jvli-postcards__stage">
        <div class="jvli-postcards__track" data-jvli-postcards-track>
          {%- assign jvli_pc_fallbacks = 'jvli-about-hangers.webp,jvli-about-hero.webp,jvli-about-sketch.webp,jvli-intro-panthal.webp' | split: ',' -%}
          {%- for block in section.blocks -%}
            {%- assign jvli_pc_fb_idx = forloop.index0 | modulo: jvli_pc_fallbacks.size -%}
            {%- assign jvli_pc_fb = jvli_pc_fallbacks[jvli_pc_fb_idx] -%}
            <article
              class="jvli-postcard{% if forloop.first %} is-active{% endif %}"
              data-jvli-postcard
              aria-roledescription="slide"
              aria-label="Review {{ forloop.index }} of {{ section.blocks.size }}"
              {% unless forloop.first %}aria-hidden="true"{% endunless %}
              {{ block.shopify_attributes }}
            >
              <div class="jvli-postcard__paper" aria-hidden="true"></div>

              <div class="jvli-postcard__left">
                <div class="jvli-postcard__photo-wrap">
                  <div class="jvli-postcard__photo-stamp">
                    {%- if block.settings.image != blank -%}
                      <img
                        src="{{ block.settings.image | image_url: width: 800 }}"
                        alt="{{ block.settings.image.alt | default: block.settings.name | default: 'JVLI customer photo' | escape }}"
                        width="400"
                        height="500"
                        loading="lazy"
                      >
                    {%- else -%}
                      <img
                        src="{{ jvli_pc_fb | asset_url }}"
                        alt="JVLI everyday wear"
                        width="400"
                        height="500"
                        loading="lazy"
                      >
                    {%- endif -%}
                  </div>

                  <img
                    class="jvli-postcard__wax"
                    src="{{ 'jvli-wax-seal.png' | asset_url }}"
                    alt=""
                    width="1024"
                    height="1009"
                    loading="lazy"
                  >
                </div>
              </div>

              <div class="jvli-postcard__right">
                <div class="jvli-postcard__top" aria-hidden="true">
                  <img
                    class="jvli-postcard__postmark"
                    src="{{ 'jvli-postmark.png' | asset_url }}"
                    alt=""
                    width="797"
                    height="410"
                    loading="lazy"
                  >

                  <span class="jvli-postcard__stamp">
                    <svg viewBox="0 0 88 104" focusable="false">
                      <rect x="0" y="0" width="88" height="104" fill="#1e1915"/>
                      <path
                        d="M 2 2 L 6.6 2 A 2.4 2.4 0 0 0 11.4 2 L 14.4 2 A 2.4 2.4 0 0 0 19.2 2 L 22.2 2 A 2.4 2.4 0 0 0 27.0 2 L 29.9 2 A 2.4 2.4 0 0 0 34.7 2 L 37.7 2 A 2.4 2.4 0 0 0 42.5 2 L 45.5 2 A 2.4 2.4 0 0 0 50.3 2 L 53.3 2 A 2.4 2.4 0 0 0 58.1 2 L 61.0 2 A 2.4 2.4 0 0 0 65.8 2 L 68.8 2 A 2.4 2.4 0 0 0 73.6 2 L 76.6 2 A 2.4 2.4 0 0 0 81.4 2 L 86 2 L 86 6.6 A 2.4 2.4 0 0 0 86 11.4 L 86 14.4 A 2.4 2.4 0 0 0 86 19.2 L 86 22.2 A 2.4 2.4 0 0 0 86 27.0 L 86 30.1 A 2.4 2.4 0 0 0 86 34.9 L 86 37.9 A 2.4 2.4 0 0 0 86 42.7 L 86 45.7 A 2.4 2.4 0 0 0 86 50.5 L 86 53.5 A 2.4 2.4 0 0 0 86 58.3 L 86 61.3 A 2.4 2.4 0 0 0 86 66.1 L 86 69.1 A 2.4 2.4 0 0 0 86 73.9 L 86 77.0 A 2.4 2.4 0 0 0 86 81.8 L 86 84.8 A 2.4 2.4 0 0 0 86 89.6 L 86 92.6 A 2.4 2.4 0 0 0 86 97.4 L 86 102 L 81.4 102 A 2.4 2.4 0 0 0 76.6 102 L 73.6 102 A 2.4 2.4 0 0 0 68.8 102 L 65.8 102 A 2.4 2.4 0 0 0 61.0 102 L 58.1 102 A 2.4 2.4 0 0 0 53.3 102 L 50.3 102 A 2.4 2.4 0 0 0 45.5 102 L 42.5 102 A 2.4 2.4 0 0 0 37.7 102 L 34.7 102 A 2.4 2.4 0 0 0 29.9 102 L 27.0 102 A 2.4 2.4 0 0 0 22.2 102 L 19.2 102 A 2.4 2.4 0 0 0 14.4 102 L 11.4 102 A 2.4 2.4 0 0 0 6.6 102 L 2 102 L 2 97.4 A 2.4 2.4 0 0 0 2 92.6 L 2 89.6 A 2.4 2.4 0 0 0 2 84.8 L 2 81.8 A 2.4 2.4 0 0 0 2 77.0 L 2 73.9 A 2.4 2.4 0 0 0 2 69.1 L 2 66.1 A 2.4 2.4 0 0 0 2 61.3 L 2 58.3 A 2.4 2.4 0 0 0 2 53.5 L 2 50.5 A 2.4 2.4 0 0 0 2 45.7 L 2 42.7 A 2.4 2.4 0 0 0 2 37.9 L 2 34.9 A 2.4 2.4 0 0 0 2 30.1 L 2 27.0 A 2.4 2.4 0 0 0 2 22.2 L 2 19.2 A 2.4 2.4 0 0 0 2 14.4 L 2 11.4 A 2.4 2.4 0 0 0 2 6.6 Z"
                        fill="#f8f2e6"
                      />
                      <rect x="8.5" y="8.5" width="71" height="87" fill="none" stroke="#1e1915" stroke-width="1"/>
                      <text x="44" y="18.5" text-anchor="middle" fill="#1e1915" font-size="6.8" font-weight="600" letter-spacing="1.1">JVLI · INDIA</text>
                      <rect x="14.5" y="22.5" width="59" height="60" fill="#c76432"/>
                      <!-- Terracotta sunset & temple/botanical stamp illustration -->
                      <circle cx="44" cy="45" r="15.5" fill="#e6a96c"/>
                      <path d="M28 77c0-12 7-21 16-27 9 6 16 15 16 27Z" fill="#7c281c"/>
                      <path d="M44 50v27M36 61c3-2 6-1 8 2m0-2c2-3 5-4 8-2" stroke="#f7e3c8" stroke-width="1.5" fill="none" stroke-linecap="round"/>
                      <text x="44" y="91.5" text-anchor="middle" fill="#1e1915" font-size="6.2" font-weight="600" letter-spacing="1.1">POSTAGE · 2026</text>
                    </svg>
                  </span>
                </div>

                <div class="jvli-postcard__message">
                  <blockquote class="jvli-postcard__quote" data-jvli-postcard-quote>“{{ block.settings.quote | strip | escape | newline_to_br }}”</blockquote>
                  <button type="button" class="jvli-postcard__more" data-jvli-postcard-more hidden>Read more</button>
                </div>

                <div class="jvli-postcard__from">
                  <span class="jvli-postcard__love">With love,</span>
                  {%- if block.settings.name != blank -%}
                    <span class="jvli-postcard__name">{{ block.settings.name | escape }}</span>
                  {%- endif -%}
                  {%- liquid
                    assign jvli_pc_meta = block.settings.city | strip | escape
                    if block.settings.verified
                      if jvli_pc_meta != blank
                        assign jvli_pc_meta = jvli_pc_meta | append: ' · '
                      endif
                      assign jvli_pc_meta = jvli_pc_meta | append: 'Verified customer'
                    endif
                  -%}
                  {%- if jvli_pc_meta != blank -%}
                    <span class="jvli-postcard__meta">{{ jvli_pc_meta }}</span>
                  {%- endif -%}
                </div>
              </div>
            </article>
          {%- endfor -%}
        </div>

        {%- if section.blocks.size > 1 -%}
          <button type="button" class="jvli-postcards__arrow jvli-postcards__arrow--prev" data-jvli-postcards-prev aria-label="Previous review">
            {%- render 'jvli-icon', icon: 'chevron' -%}
          </button>
          <button type="button" class="jvli-postcards__arrow jvli-postcards__arrow--next" data-jvli-postcards-next aria-label="Next review">
            {%- render 'jvli-icon', icon: 'chevron' -%}
          </button>
        {%- endif -%}
      </div>

      {%- comment -%}
        The full review, opened by "Read more" on a long one. jvli-postcards.js
        moves it to the end of <body> and fills it from the card.
      {%- endcomment -%}
      <div class="jvli jvli-pc-modal" data-jvli-postcards-modal hidden>
        <div class="jvli-pc-modal__backdrop" data-jvli-postcards-close></div>
        <div class="jvli-pc-modal__card" role="dialog" aria-modal="true" aria-label="Full review">
          <div class="jvli-postcard__paper" aria-hidden="true"></div>
          <button type="button" class="jvli-pc-modal__close" data-jvli-postcards-close aria-label="Close">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18"/></svg>
          </button>
          <div class="jvli-pc-modal__body" data-jvli-postcards-modal-body tabindex="0"></div>
          {%- if section.settings.show_flowers -%}
            <img class="jvli-postcard__sprig" src="{{ 'jvli-sprig-card.webp' | asset_url }}" alt="" width="204" height="246" loading="lazy">
          {%- endif -%}
        </div>
      </div>

      {%- if section.blocks.size > 1 -%}
        <div class="jvli-postcards__dots">
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="jvli-postcards__dot"
              data-jvli-postcards-dot="{{ forloop.index0 }}"
              aria-label="Show review {{ forloop.index }}"
              {% if forloop.first %}aria-current="true"{% endif %}
            ></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "JVLI Postcards",
  "class": "jvli-section-postcards",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "A little love from our community" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Postcards from you." },
    { "type": "text", "id": "text", "label": "Text", "default": "Little notes, lovely people, and stories from the other side of every order." },
    { "type": "checkbox", "id": "show_flowers", "label": "Show bougainvillea", "default": true }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "paragraph", "content": "Use real reviews only, in the customer's own words, with their permission." },
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "textarea", "id": "quote", "label": "Review" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "city", "label": "City" },
        { "type": "checkbox", "id": "verified", "label": "Verified customer", "info": "Tick only if this person bought from JVLI.", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "JVLI Postcards" }]
}
{% endschema %}
