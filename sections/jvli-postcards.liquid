{%- comment -%}
  Postcards from you: customer reviews as postcards in a carousel.
  Each review is a block typed in the theme editor. Only add real reviews,
  and tick "Verified customer" only for people who bought from JVLI.
  The section renders nothing until it has at least one review.
  jvli-postcards.js runs the arrows, dots and swipe.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  {%- render 'jvli-assets' -%}
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@1,400&display=swap">
  {{ 'jvli-postcards.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'jvli-postcards.js' | asset_url }}" defer></script>

  <section
    class="jvli jvli-postcards jvli-section"
    data-jvli-postcards
    aria-roledescription="carousel"
    aria-labelledby="JvliPostcards-{{ section.id }}"
  >
    {%- if section.settings.show_flowers -%}
      <img
        class="jvli-postcards__corner"
        src="{{ 'jvli-sprig-corner.webp' | asset_url }}"
        alt=""
        width="290"
        height="192"
        loading="lazy"
      >
    {%- endif -%}

    <div class="jvli-container">
      <div class="jvli-postcards__head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="jvli-eyebrow jvli-postcards__eyebrow"><span>{{ section.settings.eyebrow }}</span></p>
        {%- endif -%}
        <h2 class="jvli-h2" id="JvliPostcards-{{ section.id }}">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="jvli-postcards__text">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>

      <div class="jvli-postcards__stage">
        <div class="jvli-postcards__track" data-jvli-postcards-track>
          {%- for block in section.blocks -%}
            <article
              class="jvli-postcard{% if forloop.first %} is-active{% endif %}"
              data-jvli-postcard
              aria-roledescription="slide"
              aria-label="Review {{ forloop.index }} of {{ section.blocks.size }}"
              {% unless forloop.first %}aria-hidden="true"{% endunless %}
              {{ block.shopify_attributes }}
            >
              <div class="jvli-postcard__paper" aria-hidden="true"></div>
              {%- if section.settings.show_flowers -%}
                <img
                  class="jvli-postcard__sprig"
                  src="{{ 'jvli-sprig-card.webp' | asset_url }}"
                  alt=""
                  width="204"
                  height="246"
                  loading="lazy"
                >
              {%- endif -%}

              <div class="jvli-postcard__message">
                <blockquote class="jvli-postcard__quote">“{{ block.settings.quote | strip | escape | newline_to_br }}”</blockquote>
              </div>

              <div class="jvli-postcard__address">
                <div class="jvli-postcard__top" aria-hidden="true">
                  <span class="jvli-postcard__label">Post card</span>
                  <svg class="jvli-postcard__postmark" viewBox="0 0 120 64" focusable="false">
                    <path d="M2 18c8-5 14 5 22 0s14-5 22 0M2 28c8-5 14 5 22 0s14-5 22 0M2 38c8-5 14 5 22 0s14-5 22 0M2 48c8-5 14 5 22 0s14-5 22 0" />
                    <circle cx="86" cy="33" r="29" />
                    <circle cx="86" cy="33" r="23" stroke-dasharray="2 3" />
                    <text x="86" y="38" text-anchor="middle">JVLI</text>
                  </svg>
                  <span class="jvli-postcard__stamp">
                    <svg viewBox="0 0 40 48" focusable="false">
                      <path d="M20 46V20M20 34c-5-1-9-4-10-9 5 0 9 3 10 9Zm0-7c5-1 9-4 10-9-5 0-9 3-10 9Z" />
                      <path d="M20 20c-4-2-6-6-5-11 4 1 6 4 5 11Zm0 0c4-2 6-6 5-11-4 1-6 4-5 11Zm0 0c-1-5 0-9 0-14 1 5 1 9 0 14Z" />
                    </svg>
                  </span>
                </div>
                <div class="jvli-postcard__from">
                  <p class="jvli-postcard__love">With love,</p>
                  <p class="jvli-postcard__name">{{ block.settings.name | escape }}</p>
                  {%- liquid
                    assign jvli_pc_meta = block.settings.city | strip | escape
                    if block.settings.verified
                      if jvli_pc_meta != blank
                        assign jvli_pc_meta = jvli_pc_meta | append: ' · '
                      endif
                      assign jvli_pc_meta = jvli_pc_meta | append: 'Verified customer'
                    endif
                  -%}
                  {%- if jvli_pc_meta != blank -%}
                    <p class="jvli-postcard__meta">{{ jvli_pc_meta }}</p>
                  {%- endif -%}
                </div>
              </div>
            </article>
          {%- endfor -%}
        </div>

        {%- if section.blocks.size > 1 -%}
          <button type="button" class="jvli-postcards__arrow jvli-postcards__arrow--prev" data-jvli-postcards-prev aria-label="Previous review">
            {%- render 'jvli-icon', icon: 'chevron' -%}
          </button>
          <button type="button" class="jvli-postcards__arrow jvli-postcards__arrow--next" data-jvli-postcards-next aria-label="Next review">
            {%- render 'jvli-icon', icon: 'chevron' -%}
          </button>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 1 -%}
        <div class="jvli-postcards__dots">
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="jvli-postcards__dot"
              data-jvli-postcards-dot="{{ forloop.index0 }}"
              aria-label="Show review {{ forloop.index }}"
              {% if forloop.first %}aria-current="true"{% endif %}
            ></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "JVLI Postcards",
  "class": "jvli-section-postcards",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "A little love from our community" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Postcards from you." },
    { "type": "text", "id": "text", "label": "Text", "default": "Little notes, lovely people, and stories from the other side of every order." },
    { "type": "checkbox", "id": "show_flowers", "label": "Show bougainvillea", "default": true }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "paragraph", "content": "Use real reviews only, in the customer's own words, with their permission." },
        { "type": "textarea", "id": "quote", "label": "Review" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "city", "label": "City" },
        { "type": "checkbox", "id": "verified", "label": "Verified customer", "info": "Tick only if this person bought from JVLI.", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "JVLI Postcards" }]
}
{% endschema %}
