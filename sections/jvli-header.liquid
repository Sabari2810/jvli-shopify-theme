{%- render 'jvli-assets' -%}
{%- liquid
  assign jvli_overlay = false
  if request.page_type == 'index' and section.settings.transparent_on_home
    assign jvli_overlay = true
  endif
  assign jvli_fav_url = section.settings.favorites_link | default: '/pages/favorites'
-%}
{%- capture jvli_logo -%}
  {%- if section.settings.logo_style == 'image' and section.settings.logo != blank -%}
    <img
      class="jvli-header__logo-image"
      src="{{ section.settings.logo | image_url: width: 600 }}"
      alt="{{ shop.name | escape }}"
      width="{{ section.settings.logo_width }}"
      height="{{ section.settings.logo_width | divided_by: section.settings.logo.aspect_ratio | round }}"
      style="--jvli-logo-width: {{ section.settings.logo_width }}px;"
    >
  {%- else -%}
    <span class="jvli-header__wordmark">{{ section.settings.logo_text | default: shop.name }}</span>
  {%- endif -%}
{%- endcapture -%}

<header
  class="jvli jvli-header{% if jvli_overlay %} jvli-header--overlay{% endif %}"
  data-jvli-header
  {% if jvli_overlay %}data-jvli-header-overlay{% endif %}
>
  <div class="jvli-header__inner">
    <a href="{{ routes.root_url }}" class="jvli-header__logo" aria-label="{{ shop.name | escape }}">
      {{- jvli_logo -}}
    </a>

    <nav class="jvli-header__nav" aria-label="Main">
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
      {%- endfor -%}
    </nav>

    <div class="jvli-header__actions">
      <a href="{{ routes.search_url }}" class="jvli-header__icon jvli-header__icon--search" aria-label="Search">
        {%- render 'jvli-icon', icon: 'search' -%}
      </a>
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="jvli-header__icon jvli-header__icon--account" aria-label="Account">
          {%- render 'jvli-icon', icon: 'account' -%}
        </a>
      {%- endif -%}
      {%- if section.settings.show_favorites -%}
        <a href="{{ jvli_fav_url }}" class="jvli-header__icon jvli-header__icon--favorites" aria-label="Favorites">
          {%- render 'jvli-icon', icon: 'heart' -%}
          <span class="jvli-header__count jvli-header__count--favorites" data-jvli-favorites-count hidden>0</span>
        </a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="jvli-header__icon jvli-header__icon--bag" aria-label="Bag, {{ cart.item_count }} items">
        {%- render 'jvli-icon', icon: 'bag' -%}
        <span class="jvli-header__count" data-jvli-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
      </a>

      <details class="jvli-menu" data-jvli-menu>
        <summary class="jvli-header__icon jvli-menu__toggle" aria-label="Menu">
          {%- render 'jvli-icon', icon: 'menu' -%}
        </summary>
        <div class="jvli-menu__panel">
          <div class="jvli-menu__top">
            {{- jvli_logo -}}
            <button type="button" class="jvli-header__icon" data-jvli-menu-close aria-label="Close menu">
              {%- render 'jvli-icon', icon: 'close' -%}
            </button>
          </div>
          <nav class="jvli-menu__nav" aria-label="Mobile">
            {%- for link in section.settings.menu.links -%}
              <a href="{{ link.url }}">
                <span>{{ link.title }}</span>
                {%- render 'jvli-icon', icon: 'arrow' -%}
              </a>
            {%- endfor -%}
          </nav>
          <div class="jvli-menu__footer">
            <a href="{{ routes.search_url }}">Search</a>
            {%- if shop.customer_accounts_enabled -%}<a href="{{ routes.account_url }}">Account</a>{%- endif -%}
            <a href="{{ routes.cart_url }}">Bag</a>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "JVLI Header",
  "class": "jvli-section-header",
  "settings": [
    { "type": "select", "id": "logo_style", "label": "Logo", "default": "text", "options": [
      { "value": "text", "label": "Text wordmark" },
      { "value": "image", "label": "Logo image" }
    ] },
    { "type": "text", "id": "logo_text", "label": "Wordmark text", "default": "JVLI" },
    { "type": "image_picker", "id": "logo", "label": "Logo image" },
    { "type": "range", "id": "logo_width", "label": "Logo image width", "min": 60, "max": 240, "step": 5, "unit": "px", "default": 110 },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "checkbox", "id": "transparent_on_home", "label": "Transparent over the home page hero", "default": true },
    { "type": "checkbox", "id": "show_favorites", "label": "Show favorites icon", "default": true },
    { "type": "url", "id": "favorites_link", "label": "Favorites link", "info": "Defaults to /pages/favorites." }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
