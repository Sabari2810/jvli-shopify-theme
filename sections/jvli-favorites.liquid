{%- render 'jvli-assets' -%}
{%- comment -%}
  Favorites page. jvli-favorites.js fills the grid with the shopper's saved
  products (from their account, or from this browser when signed out) and
  sets data-state: loading | ready | empty | error.
{%- endcomment -%}
<section class="jvli jvli-favorites jvli-section" data-jvli-favorites-page data-state="loading">
  <div class="jvli-container">
    <div class="jvli-favorites__head">
      <h1 class="jvli-h2">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}
        <p class="jvli-favorites__text">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>

    {%- unless customer -%}
      <p class="jvli-favorites__note" data-jvli-favorites-guest-note>
        Your favorites are saved on this device.
        <a href="{{ routes.account_login_url }}?return_url=%2Fpages%2Ffavorites">Log in</a>
        to keep them in your account and see them anywhere.
      </p>
    {%- endunless -%}

    <p class="jvli-favorites__status jvli-favorites__status--loading" role="status">Loading your favorites…</p>
    <div class="jvli-favorites__status jvli-favorites__status--empty">
      <p>{{ section.settings.empty_text }}</p>
      <a href="{{ section.settings.empty_link | default: routes.all_products_collection_url }}" class="jvli-button jvli-button--dark">
        {{ section.settings.empty_label }}
        {%- render 'jvli-icon', icon: 'arrow' -%}
      </a>
    </div>
    <p class="jvli-favorites__status jvli-favorites__status--error" role="alert">
      We couldn't load your favorites just now. Please refresh the page to try again.
    </p>

    <div class="jvli-favorites__grid" data-jvli-favorites-grid></div>
  </div>
</section>

{% schema %}
{
  "name": "JVLI Favorites",
  "class": "jvli-section-favorites",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your favorites" },
    { "type": "text", "id": "text", "label": "Text", "default": "Pieces you've saved for later." },
    { "type": "text", "id": "empty_text", "label": "Empty message", "default": "You haven't saved anything yet. Tap the heart on any piece to keep it here." },
    { "type": "text", "id": "empty_label", "label": "Empty button text", "default": "Start shopping" },
    { "type": "url", "id": "empty_link", "label": "Empty button link" }
  ],
  "presets": [{ "name": "JVLI Favorites" }]
}
{% endschema %}
