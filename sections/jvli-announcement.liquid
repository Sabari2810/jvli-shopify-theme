{%- render 'jvli-assets' -%}
<div
  class="jvli jvli-announcement"
  style="--jvli-announce-bg: {{ section.settings.background }}; --jvli-announce-fg: {{ section.settings.text_color }};"
>
  <div class="jvli-announcement__inner">
    <p class="jvli-announcement__text">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
      {%- else -%}
        {{- section.settings.text -}}
      {%- endif -%}
    </p>
    {%- if section.settings.side_text != blank -%}
      <p class="jvli-announcement__side">{{ section.settings.side_text }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "JVLI Announcement",
  "class": "jvli-section-announcement",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Made in Tamil Nadu, for everyday stories" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "text", "id": "side_text", "label": "Right-hand text (desktop)", "default": "Free shipping on orders above ₹999" },
    { "type": "color", "id": "background", "label": "Background", "default": "#763530" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" }
  ],
  "presets": [{ "name": "JVLI Announcement" }],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
