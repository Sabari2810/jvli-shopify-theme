{%- render 'jvli-assets' -%}
<div
  class="jvli jvli-announcement"
  style="--jvli-announce-bg: {{ section.settings.background }}; --jvli-announce-fg: {{ section.settings.text_color }};"
>
  <div class="jvli-announcement__inner">
    <p class="jvli-announcement__text">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
      {%- else -%}
        {{- section.settings.text -}}
      {%- endif -%}
    </p>
    {%- if section.settings.side_text != blank -%}
      <p class="jvli-announcement__side">{{ section.settings.side_text }}</p>
    {%- endif -%}
    <button type="button" class="jvli-announcement__close" data-jvli-announcement-close aria-label="Close announcement">
      {%- render 'jvli-icon', icon: 'close' -%}
    </button>
  </div>
</div>
{%- comment -%}
  The cross hides the bar for this shopper. The choice is remembered for
  this exact text, so a new announcement shows again. Runs inline so a
  closed bar never flashes on the next page.
{%- endcomment -%}
<script>
  (function () {
    var bar = document.currentScript.previousElementSibling;
    var wrap = bar.closest('.shopify-section') || bar;
    var key = 'jvli:announcement-closed';
    var id = {{ section.settings.text | append: section.settings.side_text | json }};
    if (window.Shopify && Shopify.designMode) return;
    try {
      if (localStorage.getItem(key) === id) wrap.hidden = true;
    } catch (e) {}
    bar.querySelector('[data-jvli-announcement-close]').addEventListener('click', function () {
      wrap.hidden = true;
      try {
        localStorage.setItem(key, id);
      } catch (e) {}
    });
  })();
</script>

{% schema %}
{
  "name": "JVLI Announcement",
  "class": "jvli-section-announcement",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Made in Tamil Nadu, for everyday stories" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "text", "id": "side_text", "label": "Right-hand text (desktop)", "default": "Free shipping on orders above ₹999" },
    { "type": "color", "id": "background", "label": "Background", "default": "#4b4a2e" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#faf6ee" }
  ],
  "presets": [{ "name": "JVLI Announcement" }],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
